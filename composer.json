{
    "name": "sahicheck/sahicheck-php",
    "description": "Official PHP SDK for the SahiCheck verification API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sahicheck",
        "sdk",
        "api",
        "verification",
        "phone-validation",
        "email-verification",
        "ip-lookup"
    ],
    "authors": [
        {
            "name": "SahiCheck",
            "email": "sahicheckapi@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "SahiCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SahiCheck\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
